# Copy to .env and point at this machine's installs (loaded by tools/load-env.mjs).
# A value already set in the shell takes precedence over .env.
# On Windows use the Godot *_console.exe build so headless output reaches stdout.
ANVIL_BLENDER=C:\Path\To\blender.exe
ANVIL_GODOT=C:\Path\To\Godot_v4.x-stable_win64_console.exe
ANVIL_KIT_DIR=C:\Path\To\G-Transfer\public\downloads
